# Single compose entrypoint.
# Select which optional services start by setting COMPOSE_PROFILES.
# Examples:
#   COMPOSE_PROFILES=redis,faster-whisper
#   COMPOSE_PROFILES=redis,whisper-trt,gemma
#   COMPOSE_PROFILES=redis,whisper-trt,gemma,sensevoice
COMPOSE_PROFILES=redis,faster-whisper
COMPOSE_PROJECT_NAME=voicelinkvr

# --- image sources ---
VOICELINK_IMAGE=boyqiu0010/voice-link-vr-server:latest
REDIS_IMAGE=redis:latest
FASTER_WHISPER_IMAGE=fedirz/faster-whisper-server:latest-cuda
WHISPER_TRT_IMAGE=ghcr.io/your-org/whisperlive-trt-gemma:latest
GEMMA_TRANSLATE_IMAGE=ghcr.io/your-org/translategemma-llama-server:latest
SENSEVOICE_IMAGE=ghcr.io/your-org/sensevoice-oneapi:latest

# --- host ports ---
VOICELINK_HOST_PORT=8980
REDIS_HOST_PORT=6379
FASTER_WHISPER_HOST_PORT=8000
WHISPER_TRT_WS_HOST_PORT=9090
WHISPER_TRT_REST_HOST_PORT=18100
GEMMA_TRANSLATE_BIND_IP=127.0.0.1
GEMMA_TRANSLATE_HOST_PORT=8080
SENSEVOICE_HOST_PORT=8800

# --- storage ---
REDIS_DATA_PATH=./redisFiles/data
REDIS_CONFIG_PATH=./redisFiles/redis.conf
VOICELINK_DATA_VOLUME=voice-link-vr-server-local
WL_CACHE_DIR=./.cache/whisper-trt
GEMMA_MODEL_ROOT=D:/models

# --- VoiceLink runtime ---
WHISPER_BACKEND=faster-whisper
WHISPER_HOST=faster-whisper
WHISPER_PORT=8000
WHISPER_TRT_HOST=whisper-trt
WHISPER_TRT_PORT=8000
SENSEVOICE_HOST=sensevoice
SENSEVOICE_PORT=8000
FILTER_WEB_URL=https://gitee.com/voice-link-vr/VoiceLinkServer/raw/main/src/filter.json
THREADS_NUM=50
LIMIT_ENABLE=True
# Enable legacy client migration mode:
# - uses legacy per-request counting for shared speech/translation APIs
# - enables /api/latestVersionInfo for old clients
LEGACY_CLIENT_COMPAT=False
LEGACY_MODE=True
API_V1_ENABLED=True
API_V1_LEGACY_LOGIN_ENABLED=True
API_V2_ENABLED=True
API_V2_AUTH_ENABLED=True
API_V2_PORTAL_ENABLED=True
API_V2_BILLING_ENABLED=False
API_V2_SELF_ACTIVATE_ENABLED=False
API_V2_LEGACY_MIGRATION_ENABLED=True
API_V1_HOSTS=
API_V2_HOSTS=
LIMIT_PUBLIC_TEST_USER=testuser
DEFAULT_TEST_USER_ENABLED=True
DEFAULT_TEST_USER_UUID=00000000-0000-0000-0000-000000000001
DEFAULT_TEST_USER_EMAIL=test@voicelinkvr.top
DEFAULT_TEST_USER_ACTIVE=True
DEFAULT_TEST_USER_IP_DAILY_QUOTA=800
DEFAULT_TEST_USER_IP_RATE_LIMIT=8/minute
DEFAULT_TEST_USER_RESOURCE_QUOTA=0
DEFAULT_TEST_USER_USERNAME=testuser
DEFAULT_TEST_USER_PASSWORD=abc123!
SQLALCHEMY_POOL_SIZE=0
TRANSLATOR_SERVICES_LIST=bing,modernMt,cloudTranslation,caiyun,alibaba,youdao
LIMITER_REDIS_URL=redis://redis:6379/0
ENABLE_WEB_TRANSLATORS=True
TTS_TOKEN=
TTS_URL=
QWEN_TTS_BASE_URL=http://127.0.0.1:8010
QWEN_TTS_TOKEN=
QWEN_TTS_TIMEOUT=300
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=VoiceLinkVR
SMTP_USE_SSL=True
EMAIL_CODE_LENGTH=6
EMAIL_CODE_TTL_MINUTES=10
LATEST_VERSION=v0.6.0-fix1
PACKAGE_BASE_URL=https://cloudflarestorage.boyqiu001.top/VRCLS-windows-
PACKAGE_TYPE=.exe
SQL_PATH=
AFDIAN_CUSTOM_ID_KEY=change-me-to-32-byte-secret-change-me-now
AFDIAN_WEBHOOK_FORWARD_ENABLED=False
AFDIAN_WEBHOOK_FORWARD_URL=
AFDIAN_WEBHOOK_FORWARD_TIMEOUT=10
AFDIAN_WEBHOOK_FORWARD_AUTHORIZATION=

# --- Faster-Whisper ---
FASTER_WHISPER_TTL=-1
FASTER_WHISPER_NUM_WORKERS=10
FASTER_WHISPER_CPU_THREADS=40

# --- WhisperLive-TRT-Gemma ---
WHISPER_TRT_ENABLE_REST=true
WHISPER_TRT_REST_PORT=8000
WHISPER_TRT_MULTILINGUAL=true
TRANSLATE_SERVICE_URL=http://gemma-translate:8080
AUTO_BUILD_TRT_MODEL=true
TRT_BUILD_MODEL_NAME=large-v3
TRT_WEIGHT_ONLY_PRECISION=float16
TRT_PY_SESSION=false
TRT_BUILD_INFERENCE_PRECISION=float16
TRT_BUILD_MAX_BATCH_SIZE=1
TRT_BUILD_MAX_BEAM_WIDTH=1
TRT_BUILD_ENCODER_MAX_INPUT_LEN=3000
TRT_BUILD_ENCODER_MAX_SEQ_LEN=3000
TRT_BUILD_DECODER_MAX_SEQ_LEN=225
TRT_BUILD_DECODER_MAX_INPUT_LEN=32
TRT_BUILD_DECODER_MAX_ENCODER_INPUT_LEN=3000
TRT_BUILD_DECODER_MAX_NUM_TOKENS=
TRT_RUNTIME_MAX_BATCH_SIZE=1
TRT_RUNTIME_MAX_INPUT_LEN=3000
TRT_RUNTIME_MAX_OUTPUT_LEN=64
TRT_RUNTIME_MAX_BEAM_WIDTH=1
TRT_KV_CACHE_FREE_GPU_MEMORY_FRACTION=0.55
TRT_CROSS_KV_CACHE_FRACTION=0.30
CONTEXT_FMHA_MODE=auto
BERT_ATTENTION_PLUGIN_MODE=auto
GPT_ATTENTION_PLUGIN_MODE=auto
CORS_ORIGINS=http://127.0.0.1:18100,http://localhost:18100

# --- TranslateGemma ---
GEMMA_MODEL_NAME=translategemma-12b-it-MP-GGUF
GEMMA_TRANSLATE_ENABLED=False
GEMMA_TRANSLATE_URL=gemma-translate:8080
# New TranslateGemma deployment is llama-server only; keep this as openai.
GEMMA_TRANSLATE_API_MODE=completion
GEMMA_TRANSLATE_MODEL=translategemma-12b-it-MP-GGUF
GEMMA_TRANSLATE_TIMEOUT=10.0
GEMMA_TRANSLATE_MAX_TOKENS=500
GEMMA_TRANSLATE_FALLBACK=True
LLAMA_N_GPU_LAYERS=-1
LLAMA_N_PARALLEL=2
LLAMA_N_CTX=3072
LLAMA_FLASH_ATTN=on
LLAMA_EXTRA_ARGS=

# --- SenseVoice ---
SENSEVOICE_DEVICE_TYPE=cuda:0
SENSEVOICE_USE_ITN=True
SENSEVOICE_NCPU=8
SENSEVOICE_VAD_ENABLE=False
