FROM python:3.12-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's/deb.debian.org/mirrors.ustc.edu.cn/g' /etc/apt/sources.list.d/debian.sources
RUN apt-get update && apt-get install -y curl \
    && curl -sL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get install -y libopus-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /usr/src/app

# 设置 Pypi 镜像源 (可选)
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple

COPY ./src/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY ./src .
COPY run.py .
EXPOSE 8980

# 环境变量保持不变
ENV VOICELINK_RUNTIME_MODE=all
ENV VOICELINK_RUN_SCHEDULER=true
ENV VOICELINK_RUN_SCHEMA_UPGRADE=true
ENV WHISPER_HOST=host.docker.internal
ENV WHISPER_PORT=8000
ENV WHISPER_ENDPOINTS=
ENV WHISPER_BACKEND=faster-whisper
ENV WHISPER_ASR_TIMEOUT=30
ENV ASR_BACKEND_STATUS_ENABLED=false
ENV ASR_BACKEND_STATUS_TTL_SECONDS=1.5
ENV ASR_BACKEND_STATUS_TIMEOUT_SECONDS=0.6
ENV ASR_BACKEND_STATUS_OVERLOAD_ACTIVE_REQUESTS=4
ENV ASR_BACKEND_STATUS_OVERLOAD_OLDEST_SECONDS=30
ENV ASR_BACKEND_STATUS_OVERLOAD_MIN_SECONDS=12
ENV ASR_BACKEND_STATUS_RECOVERY_ACTIVE_REQUESTS=2
ENV ASR_BACKEND_STATUS_RECOVERY_OLDEST_SECONDS=12
ENV ASR_QUEUE_LIMIT_ENABLED=true
ENV ASR_QUEUE_MAX_CONCURRENCY=4
ENV ASR_QUEUE_MAX_WAITING=4
ENV ASR_QUEUE_TIMEOUT_SECONDS=1.5
ENV ASR_QUEUE_RETRY_AFTER_SECONDS=2
ENV ASR_QUEUE_WHISPER_MAX_CONCURRENCY=4
ENV ASR_QUEUE_WHISPER_MAX_WAITING=4
ENV ASR_QUEUE_WHISPER_TIMEOUT_SECONDS=1.5
ENV ASR_QUEUE_WHISPER_RETRY_AFTER_SECONDS=2
ENV ASR_QUEUE_FIRERED_MAX_CONCURRENCY=4
ENV ASR_QUEUE_FIRERED_MAX_WAITING=4
ENV ASR_QUEUE_FIRERED_TIMEOUT_SECONDS=1.5
ENV ASR_QUEUE_FIRERED_RETRY_AFTER_SECONDS=2
ENV ASR_CANCEL_CHECK_INTERVAL_SECONDS=0.25
ENV ASR_HARD_TIMEOUT_GRACE_SECONDS=10
ENV ASR_ENDPOINT_CIRCUIT_BREAKER_ENABLED=true
ENV ASR_ENDPOINT_CIRCUIT_WINDOW_SECONDS=60
ENV ASR_ENDPOINT_CIRCUIT_CONSECUTIVE_TIMEOUTS=2
ENV ASR_ENDPOINT_CIRCUIT_CONSECUTIVE_FAILURES=3
ENV ASR_ENDPOINT_CIRCUIT_TIMEOUT_RATE=0.2
ENV ASR_ENDPOINT_CIRCUIT_MIN_SAMPLES=5
ENV ASR_ENDPOINT_CIRCUIT_OPEN_SECONDS=15
ENV ASR_ENDPOINT_CIRCUIT_RETRY_AFTER_SECONDS=2
ENV WHISPER_TRT_HOST=host.docker.internal
ENV WHISPER_TRT_PORT=8000
ENV ASR_DEFAULT_ENGINE=firered
ENV FIRERED_ASR_HOST=192.168.2.81
ENV FIRERED_ASR_PORT=8008
ENV FIRERED_ASR_TIMEOUT=120
ENV translators_default_region=CN
ENV TRANSLATOR_SERVICE=alibaba
ENV ADMIN_STATS_CACHE_TTL_SECONDS=45
ENV CLIENT_DISCONNECT_CHECK_TIMEOUT_SECONDS=0.05
ENV SQL_PATH=sqlite:////usr/src/app/data/db/users.db

# 使用 Uvicorn 启动 - main.py 在工作目录中
CMD ["python", "run.py"]
